# =================================================================
# LoveVerse — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# =================================================================

# Local Express dev server port (default 3000)
PORT=3000

# -----------------------------------------------------------------
# GMAIL SMTP — Required for email notifications
# -----------------------------------------------------------------

# 1. Gmail address used to SEND notification emails (the FROM address)
SMTP_USER=your-gmail@gmail.com

# 2. Google App Password (16 characters, NOT your regular password)
#    Generate one at: https://myaccount.google.com/apppasswords
#    Example format:  abcd efgh ijkl mnop  (spaces OK, auto-stripped)
SMTP_PASS=abcd efgh ijkl mnop

# -----------------------------------------------------------------
# ADMIN DASHBOARD — Optional (defaults shown)
# -----------------------------------------------------------------

# Admin dashboard password (change this before deploying!)
ADMIN_PASSWORD=loveverse2026

# -----------------------------------------------------------------
# NETLIFY ENVIRONMENT VARIABLES
# Set these in: Netlify → Site → Environment Variables
# -----------------------------------------------------------------
# SMTP_USER  = your-gmail@gmail.com
# SMTP_PASS  = abcd efgh ijkl mnop
# ADMIN_PASSWORD = your-strong-password
