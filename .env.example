# =================================================================
# LoveVerse — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# =================================================================

# Local Express dev server port (default 3000)
PORT=3000

# -----------------------------------------------------------------
# EMAIL PROVIDER OPTION 1: RESEND (Recommended & Fast)
# -----------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
# RESEND_API_KEY=re_123456789
# RESEND_FROM=LoveVerse <onboarding@resend.dev>

# -----------------------------------------------------------------
# EMAIL PROVIDER OPTION 2: GMAIL SMTP
# -----------------------------------------------------------------
# 1. Gmail address used to SEND notification emails (FROM address)
SMTP_USER=your-gmail@gmail.com

# 2. Google App Password (16 characters, NOT regular Gmail password)
#    Generate one at: https://myaccount.google.com/apppasswords
SMTP_PASS=abcd efgh ijkl mnop

# -----------------------------------------------------------------
# ADMIN DASHBOARD — Optional (defaults shown)
# -----------------------------------------------------------------
ADMIN_PASSWORD=loveverse2026

# -----------------------------------------------------------------
# NETLIFY ENVIRONMENT VARIABLES
# Configure these in: Netlify → Site Settings → Environment Variables
